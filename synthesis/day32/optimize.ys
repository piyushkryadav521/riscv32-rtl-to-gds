# ============================================================
# RV32I Processor - Synthesis Optimization
# ============================================================

# Read RTL
read_verilog rtl/program_counter.v
read_verilog rtl/instruction_memory.v
read_verilog rtl/instruction_decoder.v
read_verilog rtl/register_file.v
read_verilog rtl/immediate_generator.v
read_verilog rtl/alu.v
read_verilog rtl/alu_control.v
read_verilog rtl/control_unit.v
read_verilog rtl/data_memory.v
read_verilog rtl/branch_unit.v
read_verilog rtl/riscv_cpu.v
read_verilog rtl/top.v

# Set top-level module
hierarchy -top top

# RTL process conversion
proc
opt

# FSM optimization
fsm
opt

# Memory conversion and optimization
memory
opt

# Technology mapping
techmap
opt

# Flatten hierarchy
flatten
opt

# ABC logic optimization
abc -g simple

# Final cleanup
opt_clean

# Write optimized netlist
write_verilog -noattr synthesis/day32/netlist/riscv32_optimized.v

# Generate statistics
stat